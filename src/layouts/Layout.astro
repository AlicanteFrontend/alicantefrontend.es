---
import '../styles/global.css';
import { Schema } from 'astro-seo-schema';
import type { Graph } from 'schema-dts';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { languages, routes, type Lang, type Page } from '../i18n/ui';

interface Props {
	title?: string;
	description?: string;
	lang?: Lang;
	page: Page;
}

const siteUrl = 'https://alicantefrontend.es';
const description =
	'El ecosistema Frontend es un caos y ¡nos encanta! Si quieres aprender y compartir sobre desarrollo web orientado al Frontend has llegado al sitio correcto.';

const { title = 'Alicante Frontend', description: pageDescription = description, lang = 'es', page } = Astro.props;
const canonical = new URL(routes[page][lang], Astro.site).href;
const ogImage = new URL(lang === 'es' ? '/og.png' : '/en/og.png', Astro.site).href;
const ogLocales = { es: 'es_ES', en: 'en_US' } as const;
const schemaLanguages = { es: 'es-ES', en: 'en-US' } as const;

const jsonLd: Graph = {
	'@context': 'https://schema.org',
	'@graph': [
		{
			'@type': ['Organization', 'NGO'],
			'@id': `${siteUrl}/#organization`,
			name: 'Alicante Frontend',
			legalName: 'Alicante Frontend',
			url: `${siteUrl}/`,
			logo: `${siteUrl}/alicante-frontend-logo.svg`,
			image: `${siteUrl}/og.png`,
			description,
			email: 'hola@alicantefrontend.es',
			taxID: 'G42668277',
			vatID: 'G42668277',
			foundingDate: '2017-10-02',
			sameAs: [
				'https://x.com/AlicanteFront',
				'https://www.youtube.com/AlicanteFrontend',
				'https://www.meetup.com/es-ES/Alicante-Frontend',
				'https://www.linkedin.com/company/alicante-frontend/',
				'https://www.instagram.com/alicantefrontend/',
				'https://github.com/AlicanteFrontend',
			],
			address: {
				'@type': 'PostalAddress',
				streetAddress: 'Calle Goya, 14, Planta 2, Puerta F',
				addressLocality: 'San Vicente del Raspeig',
				addressRegion: 'Alicante',
				postalCode: '03690',
				addressCountry: 'ES',
			},
			location: {
				'@type': 'Place',
				name: 'San Vicente del Raspeig, Alicante',
				address: {
					'@type': 'PostalAddress',
					streetAddress: 'Calle Goya, 14, Planta 2, Puerta F',
					addressLocality: 'San Vicente del Raspeig',
					addressRegion: 'Alicante',
					postalCode: '03690',
					addressCountry: 'ES',
				},
			},
		},
		{
			'@type': 'WebSite',
			'@id': `${siteUrl}/#website`,
			url: `${siteUrl}/`,
			name: 'Alicante Frontend',
			description,
			inLanguage: Object.values(schemaLanguages),
			publisher: { '@id': `${siteUrl}/#organization` },
		},
		{
			'@type': 'WebPage',
			'@id': `${canonical}#webpage`,
			url: canonical,
			name: title,
			description: pageDescription,
			inLanguage: schemaLanguages[lang],
			isPartOf: { '@id': `${siteUrl}/#website` },
			about: { '@id': `${siteUrl}/#organization` },
		},
		{
			'@type': 'EventSeries',
			'@id': `${siteUrl}/#event-series`,
			name: 'Alicante Frontend Meetups',
			description: 'Meetup mensual sobre desarrollo web frontend en Alicante.',
			url: `${siteUrl}/`,
			image: `${siteUrl}/og.png`,
			startDate: '2017-10-02',
			inLanguage: 'es-ES',
			organizer: { '@id': `${siteUrl}/#organization` },
			location: {
				'@type': 'Place',
				name: 'Alicante',
				address: {
					'@type': 'PostalAddress',
					addressLocality: 'Alicante',
					addressRegion: 'Comunidad Valenciana',
					addressCountry: 'ES',
				},
			},
			eventSchedule: {
				'@type': 'Schedule',
				repeatFrequency: 'P1M',
			},
		},
	],
};
---

<!doctype html>
<html lang={lang}>
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<meta http-equiv="X-UA-Compatible" content="ie=edge" />
		<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
		<link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
		<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
		<meta name="theme-color" content="#3a84d0" />
		<title>{title}</title>
		<meta
			name="description"
			content={pageDescription}
		/>
		<meta itemprop="name" content="Alicante Frontend" />
		<meta
			itemprop="description"
			content={pageDescription}
		/>
		<meta itemprop="image" content={ogImage} />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:site" content="@AlicanteFront" />
		<meta name="twitter:creator" content="@AlicanteFront" />
		<meta name="twitter:image" content={ogImage} />
		<meta name="twitter:image:alt" content="Alicante Frontend Logo" />
		<meta property="og:site_name" content="Alicante Frontend" />
		<meta property="og:type" content="website" />
		<meta property="og:url" content={canonical} />
		<link rel="canonical" href={canonical} />
		{(Object.keys(languages) as Lang[]).map((l) => (
			<link rel="alternate" hreflang={l} href={new URL(routes[page][l], Astro.site).href} />
		))}
		<link rel="alternate" hreflang="x-default" href={new URL(routes[page].es, Astro.site).href} />
		<meta property="og:title" content={title} />
		<meta
			property="og:description"
			content={pageDescription}
		/>
		<meta property="og:image" content={ogImage} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:locale" content={ogLocales[lang]} />
		{(Object.keys(languages) as Lang[]).filter((l) => l !== lang).map((l) => (
			<meta property="og:locale:alternate" content={ogLocales[l]} />
		))}

		<script src="https://cdn.usefathom.com/script.js" data-site="FRZKPXBX" defer></script>
		<Schema item={jsonLd} />
	</head>
	<body class="flex min-h-screen flex-col">
		<Header lang={lang} page={page} />
		<div class="flex-1">
			<slot />
		</div>
		<Footer lang={lang} />
	</body>
</html>
